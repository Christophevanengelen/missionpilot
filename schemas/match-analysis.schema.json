{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missionpilot.local/schemas/match-analysis.schema.json",
  "title": "MatchAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hardConstraintStatus",
    "componentScores",
    "weightedScore",
    "confidence",
    "verdict",
    "summary",
    "strengths",
    "gaps",
    "risks",
    "unknowns",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "hardConstraintStatus": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    },
    "componentScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleSeniority",
        "evidenceCoverage",
        "strategicScope",
        "remoteFeasibility",
        "commercialFit",
        "domainRelevance",
        "competitiveness"
      ],
      "properties": {
        "roleSeniority": { "type": "number", "minimum": 0, "maximum": 100 },
        "evidenceCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
        "strategicScope": { "type": "number", "minimum": 0, "maximum": 100 },
        "remoteFeasibility": { "type": "number", "minimum": 0, "maximum": 100 },
        "commercialFit": { "type": "number", "minimum": 0, "maximum": 100 },
        "domainRelevance": { "type": "number", "minimum": 0, "maximum": 100 },
        "competitiveness": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "weightedScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "verdict": {
      "type": "string",
      "enum": [
        "strong_match",
        "possible_match",
        "low_priority",
        "do_not_apply",
        "needs_review"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "strengths": { "$ref": "#/$defs/findingList" },
    "gaps": { "$ref": "#/$defs/findingList" },
    "risks": { "$ref": "#/$defs/findingList" },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "nextAction": { "type": "string" }
  },
  "$defs": {
    "findingList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "evidenceIds"],
        "properties": {
          "statement": { "type": "string" },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
