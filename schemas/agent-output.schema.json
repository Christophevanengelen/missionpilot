{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missionpilot.local/schemas/agent-output.schema.json",
  "title": "AgentOutputEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "confidence",
    "data",
    "evidence",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "status": {
      "type": "string",
      "enum": ["completed", "needs_review", "failed"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "data": { "type": "object" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimKey", "referenceId", "support"],
        "properties": {
          "claimKey": { "type": "string" },
          "referenceId": { "type": "string" },
          "support": {
            "type": "string",
            "enum": ["strong", "partial", "contradictory"]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
