# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local
LOG_LEVEL=info

# Supabase — public values used by the browser.
# Local development: run `supabase start` and copy the printed URL and
# publishable key (sb_publishable_...). Legacy anon/service_role keys are
# deprecated by Supabase and must not be used in this project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only. Bypasses RLS: confined to trusted server contexts
# (Inngest functions, admin scripts). Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Inngest — server only. Leave the keys empty locally; INNGEST_DEV=1 makes the
# SDK talk to the local Inngest Dev Server instead of Inngest Cloud.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# AI providers — server only. To enable real AI CV reading (Phase 4), set
# AI_DEFAULT_PROVIDER=openai, AI_DEFAULT_MODEL to an OpenAI model (e.g.
# gpt-4o-mini), and provide OPENAI_API_KEY. With the mock provider (default),
# the app stays fully functional and deterministic — AI features degrade
# gracefully.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=mock
AI_DEFAULT_MODEL=mock-v1

# Adzuna job-search API (official, free tier) — enables auto-discovery of
# offers matching the profile. Register at developer.adzuna.com; without both
# keys the feature degrades gracefully to an explanatory note.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr

# France Travail official "Offres d'emploi v2" API (OAuth2 client-credentials)
# — a second legal discovery source (300k+ French offers, ROME-coded).
# Register an app at francetravail.io (scope: api_offresdemploiv2 o2dsoffre).
# Both-or-neither; without both, the source is simply inert.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Remotive remote/freelance feed (public API, no key). OPT-IN: set to "true"
# only if the deployment accepts Remotive's terms — attribution/link-back to
# the original posting, modest polling, and no re-publishing of their listings
# to third-party job boards (MissionPilot only shows them in the user's own
# private inbox). Leave empty to keep the source inert.
REMOTIVE_ENABLED=

# Himalayas remote-jobs API (public, no key). OPT-IN: set to "true" only if the
# deployment accepts their terms — a VISIBLE link back to himalayas.app
# crediting them as the source, and no resubmission of their listings to
# third-party job boards. Their data refreshes every 24h; polling harder buys
# nothing and risks their 429.
HIMALAYAS_ENABLED=

# Jobicy remote-jobs API (public, no key). OPT-IN: set to "true" only if the
# deployment accepts their terms, which they state inside the payload itself —
# credit Jobicy with a DIRECT LINK to the source, and every application button
# must lead to the original job URL (MissionPilot never applies on the user's
# behalf, so this one holds by construction). They ask for at most one check
# per hour.
JOBICY_ENABLED=

# Vercel scheduled endpoint protection, if used
CRON_SECRET=

# ── Le récapitulatif hebdomadaire ───────────────────────────────────────────
# Il part DORMANT : tant que DIGEST_ENABLED n'est pas "true", la tâche
# planifiée s'arrête à sa première ligne et n'écrit à personne.
#
# Le SMTP existant est configuré côté Supabase et ne sert qu'aux liens de
# connexion ; l'application, elle, n'a jamais su envoyer un e-mail. C'est ce
# que RESEND_API_KEY ouvre.
#
# DIGEST_FROM est explicite et jamais deviné : une adresse d'expéditeur fausse
# fait tomber la délivrabilité du domaine entier, y compris les liens de
# connexion, qui eux fonctionnent aujourd'hui.
RESEND_API_KEY=
DIGEST_FROM=
DIGEST_ENABLED=

# Local development user — SYNTHETIC account, local stack only.
# Used by scripts/create-dev-user.ts and the e2e tests. Choose any password
# of 8+ characters; never reuse a real one. CI generates its own per run.
DEV_USER_EMAIL=dev@missionpilot.local
DEV_USER_PASSWORD=
